CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.PROFESOR(DNI VARCHAR(10) NOT NULL PRIMARY KEY,NOMBRE VARCHAR(50),APELLIDOS VARCHAR(100),DIRECCION VARCHAR(100),FECHA_NACIMIENTO DATE,CODIGO_POSTAL VARCHAR(5),TELEFONO VARCHAR(15))
CREATE MEMORY TABLE PUBLIC.ALUMNO(DNI VARCHAR(10) NOT NULL PRIMARY KEY,NOMBRE VARCHAR(50),APELLIDOS VARCHAR(100),DIRECCION VARCHAR(100),FECHA_NACIMIENTO DATE,CODIGO_POSTAL VARCHAR(5),TELEFONO VARCHAR(15))
CREATE MEMORY TABLE PUBLIC.CURSO(COD_CURSO INTEGER NOT NULL PRIMARY KEY,NOMBRE VARCHAR(50))
CREATE MEMORY TABLE PUBLIC.AULA(COD_AULA INTEGER NOT NULL PRIMARY KEY,NUM_PISO INTEGER,NUM_PUPITRES INTEGER)
CREATE MEMORY TABLE PUBLIC.ASIGNATURA(COD_ASIGNATURA INTEGER NOT NULL PRIMARY KEY,NOMBRE VARCHAR(50),NUM_HORAS INTEGER,DNI_PROFESOR VARCHAR(10) NOT NULL,COD_CURSO INTEGER NOT NULL,CONSTRAINT FK_PROFESOR FOREIGN KEY(DNI_PROFESOR) REFERENCES PUBLIC.PROFESOR(DNI),CONSTRAINT FK_CURSO FOREIGN KEY(COD_CURSO) REFERENCES PUBLIC.CURSO(COD_CURSO))
CREATE MEMORY TABLE PUBLIC.MATRICULA(DNI_ALUMNO VARCHAR(10) NOT NULL,COD_ASIGNATURA INTEGER NOT NULL,CALIFICACION DECIMAL(4,2),INCIDENCIAS VARCHAR(255),PRIMARY KEY(DNI_ALUMNO,COD_ASIGNATURA),CONSTRAINT FK_ALUMNO FOREIGN KEY(DNI_ALUMNO) REFERENCES PUBLIC.ALUMNO(DNI),CONSTRAINT FK_MATRICULA_ASIGNATURA FOREIGN KEY(COD_ASIGNATURA) REFERENCES PUBLIC.ASIGNATURA(COD_ASIGNATURA))
CREATE MEMORY TABLE PUBLIC.HORARIO(COD_ASIGNATURA INTEGER NOT NULL,COD_AULA INTEGER NOT NULL,MES INTEGER NOT NULL,DIA INTEGER NOT NULL,HORA TIME NOT NULL,PRIMARY KEY(COD_ASIGNATURA,COD_AULA,MES,DIA,HORA),CONSTRAINT FK_HORARIO_ASIGNATURA FOREIGN KEY(COD_ASIGNATURA) REFERENCES PUBLIC.ASIGNATURA(COD_ASIGNATURA),CONSTRAINT FK_AULA FOREIGN KEY(COD_AULA) REFERENCES PUBLIC.AULA(COD_AULA))
